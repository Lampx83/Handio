#!/usr/bin/env bash
# neu-agent-deploy — NHẬN gói từ CI (GitHub Actions) qua stdin, KIỂM TRA, chép sang thư mục của root rồi ÁP DỤNG.
# Cài ở /usr/local/sbin/neu-agent-deploy (root:root 0755) bởi ci/setup-ci.sh. Được gọi qua `sudo -n` từ khoá SSH bị hạn chế
# (authorized_keys: restrict,command="sudo -n /usr/local/sbin/neu-agent-deploy \"$SSH_ORIGINAL_COMMAND\""), nên khoá CI chỉ làm được đúng việc này.
#
#   neu-agent-deploy <sha256-của-gói>  < bundle.tar.gz          triển khai web + nginx + (nếu đổi) chẩn đoán/tài khoản
#   neu-agent-deploy "publish-desktop <sha256>" < bundle.tar.gz  đưa BẢN CÀI DESKTOP + latest.json lên trang tải
#   neu-agent-deploy rollback                                     quay lại bản trước (root-owned, giữ 5 bản gần nhất)
#   neu-agent-deploy status                                       in bản đang chạy + 10 dòng lịch sử gần nhất
#
# Quy tắc an toàn:
#  - gói <= 400 MB (bản cài Desktop: <= 700 MB), mã băm SHA-256 phải khớp giá trị CI báo;
#  - chỉ nhận tệp thường/thư mục, không đường dẫn tuyệt đối/".."/liên kết/thiết bị; giải nén vào thư mục root (neu-deploy không sửa được sau khi nhận);
#  - script cài (install.sh, install-diag.sh) chạy từ BẢN SAO của root, không phải từ thư mục người khác ghi được;
#  - bản cài Desktop: tên tệp theo danh sách trắng, mã băm trong SHA256SUMS.txt/latest.json phải khớp từng tệp, KHÔNG hạ phiên bản,
#    tệp cài chép trước, latest.json chép CUỐI (máy khách không bao giờ thấy latest.json trỏ tới tệp chưa có);
#  - mỗi lần chỉ một tiến trình (flock); mọi bước dùng lại script cài đã kiểm thử (tự sao lưu, kiểm tra sau cài, tự khôi phục);
#  - MỌI lần triển khai/phát hành/rollback được ghi vào $BASE/history.log (ai, lúc nào, commit nào, kết quả).
# Không tự cài: dịch vụ đăng nhập (auth/install-auth.sh, cần mã bí mật), máy 222. Hai việc đó làm tay.
set -euo pipefail
umask 027
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

BASE="${NEU_DEPLOY_BASE:-/opt/neu-agent-deploy}"
REL="$BASE/releases"
INC="$BASE/incoming"
DLROOT="${NEU_DEPLOY_DLROOT:-/var/www/neu-agent-dl}"
HIST="$BASE/history.log"
MAX_BYTES="${NEU_DEPLOY_MAX_BYTES:-$((400 * 1024 * 1024))}"   # đổi bằng biến môi trường chỉ để kiểm thử (sudo xoá biến môi trường của người gọi)
MAX_DESKTOP_BYTES="${NEU_DEPLOY_MAX_DESKTOP_BYTES:-$((700 * 1024 * 1024))}"
KEEP=5

[ "$(id -u)" -eq 0 ] || { echo "Cần chạy bằng root (qua sudo)."; exit 1; }
install -d -m 0750 -o root -g root "$BASE" "$REL" "$INC"
exec 9>"$BASE/lock"
flock -n 9 || { echo "Đang có một lần triển khai khác. Thử lại sau."; exit 75; }

# lệnh có thể kèm mã băm trong CÙNG một chuỗi ("publish-desktop <sha>"): tách ra và kiểm từng phần (không bao giờ đưa nguyên chuỗi vào shell)
read -r CMD SHA EXTRA <<<"${1:-}"
[ -z "${EXTRA:-}" ] || { echo "Thừa tham số."; exit 2; }
if [[ "$CMD" =~ ^[0-9a-f]{64}$ ]]; then SHA="$CMD"; CMD=deploy; fi
USAGE='Cách dùng: neu-agent-deploy <sha256 64 ký tự hex> < gói.tar.gz | "publish-desktop <sha256>" < gói.tar.gz | rollback | status'

current() { readlink "$BASE/current" 2>/dev/null || true; }
now() { date -u +%FT%TZ; }
hist() { # $1=sự kiện $2=kết quả $3=mã bản/ghi chú; lấy ai/commit từ MANIFEST của gói vừa nhận (nếu có)
  local who="-" commit="-" run="-" m="${MANIFEST_FILE:-}"
  if [ -n "$m" ] && [ -f "$m" ]; then
    who=$(sed -n 's/^actor=//p' "$m" | head -1 | tr -cd 'A-Za-z0-9_.-' | cut -c1-39); commit=$(sed -n 's/^commit=//p' "$m" | head -1 | tr -cd '0-9a-f' | cut -c1-12); run=$(sed -n 's/^run=//p' "$m" | head -1 | tr -cd '0-9' | cut -c1-14)
  fi
  printf '%s | %-14s | %-6s | %s | commit %s | %s | run %s\n' "$(now)" "$1" "$2" "${3:--}" "${commit:--}" "${who:--}" "${run:--}" >> "$HIST"
  chmod 640 "$HIST" 2>/dev/null || true
}
group_hash() { # băm nhóm tệp để biết nhóm nào thay đổi giữa hai bản; $1 = thư mục bản
  local d="$1"; shift
  (cd "$d" 2>/dev/null && for f in "$@"; do [ -e "$f" ] && find "$f" -type f -print0 | sort -z | xargs -0 sha256sum 2>/dev/null; done | sha256sum | cut -d' ' -f1) || echo none
}

receive() { # $1 = giới hạn byte, $2 = thư mục đích (mới, root); nhận từ stdin, kiểm kích thước + SHA-256 + danh sách, giải nén. Trả 0 nếu hợp lệ.
  local max="$1" dest="$2" b="$INC/bundle.tar.gz" size got
  rm -f "$b"
  head -c $((max + 1)) > "$b"
  size=$(stat -c %s "$b")
  if ! { [ "$size" -gt 0 ] && [ "$size" -le "$max" ]; }; then rm -f "$b"; echo "Gói rỗng hoặc quá lớn (> $((max / 1024 / 1024)) MB)."; return 1; fi
  got=$(sha256sum "$b" | cut -d' ' -f1)
  [ "$got" = "$SHA" ] || { rm -f "$b"; echo "Mã băm không khớp (nhận $got, CI báo $SHA). Dừng."; return 1; }
  # danh sách phải sạch: chỉ - (tệp) và d (thư mục); không tuyệt đối, không "..", không liên kết/thiết bị
  if ! tar -tvzf "$b" >"$INC/list.txt" 2>"$INC/list.err"; then rm -f "$b"; echo "Không đọc được gói (không phải tar.gz hợp lệ)."; return 1; fi
  if awk '{t=substr($1,1,1); if (t!="-" && t!="d") bad=1} END{exit bad?0:1}' "$INC/list.txt"; then rm -f "$b"; echo "Gói chứa liên kết/thiết bị: bị từ chối."; return 1; fi
  if tar -tzf "$b" | awk '/^\// || /(^|\/)\.\.(\/|$)/ {bad=1} END{exit bad?0:1}'; then rm -f "$b"; echo "Gói có đường dẫn nguy hiểm (tuyệt đối hoặc ..): bị từ chối."; return 1; fi
  rm -rf "$dest"; mkdir -p "$dest"
  tar -xzf "$b" -C "$dest" --no-same-owner --no-same-permissions
  rm -f "$b"
  chown -R root:root "$dest"; chmod -R go-w "$dest"
  echo "Đã nhận $(basename "$dest") ($size byte, SHA-256 khớp)."
}

apply() { # $1 = thư mục bản (root-owned); $2 = thư mục bản đang chạy (có thể rỗng)
  local d="$1" old="${2:-}"
  echo "== nginx + web: install.sh"
  (cd "$d" && bash ./install.sh) || return 1
  local nd od
  nd=$(group_hash "$d" diag users.sh); od=none; [ -n "$old" ] && od=$(group_hash "$old" diag users.sh)
  if [ "$nd" != "$od" ] && [ -f "$d/diag/install-diag.sh" ]; then
    echo "== chẩn đoán + quản lý tài khoản: diag/install-diag.sh (có thay đổi)"
    (cd "$d" && bash ./diag/install-diag.sh) || return 1
  else
    echo "== chẩn đoán + quản lý tài khoản: không đổi, bỏ qua"
  fi
  # công cụ web (tìm kiếm + tải trang): cài/cập nhật khi thư mục tools/ đổi. Dịch vụ này là TUỲ CHỌN: lỗi ở đây KHÔNG làm hỏng cả lần triển khai
  # (install-tools.sh tự khôi phục; nginx trả 503 JSON và agent nói rõ là không tra cứu được), nhưng được báo to để người vận hành biết.
  local nt ot
  nt=$(group_hash "$d" tools); ot=none; [ -n "$old" ] && ot=$(group_hash "$old" tools)
  if [ "$nt" != "$ot" ] && [ -f "$d/tools/install-tools.sh" ] && command -v docker >/dev/null 2>&1; then
    echo "== công cụ web: tools/install-tools.sh (có thay đổi)"
    (cd "$d" && bash ./tools/install-tools.sh) || echo "!! CẢNH BÁO: cài công cụ web THẤT BẠI (đã tự khôi phục). Web và nginx vẫn chạy; tìm web tạm không dùng được. Xem nhật ký ở trên."
  else
    echo "== công cụ web: không đổi (hoặc máy chưa có Docker), bỏ qua"
  fi
  local hz; hz=$(curl -s --max-time 10 -H "Host: ai.neu.edu.vn" http://127.0.0.1/agent/healthz || true)
  echo "== kiểm tra cuối: /agent/healthz=$hz"
  case "$hz" in '{"ok":true}'*) ;; *) echo "healthz không báo ok"; return 1;; esac
}

prune() {
  (cd "$REL" && ls -1dt */ 2>/dev/null | tail -n +$((KEEP + 1)) | while read -r d; do
    [ "$BASE/releases/${d%/}" = "$(current)" ] || [ "$BASE/releases/${d%/}" = "$(readlink "$BASE/previous" 2>/dev/null || true)" ] || rm -rf "$REL/${d%/}"
  done) || true
}

# ---------------------------------------------------------------- bản cài Desktop
INSTALLER_RE='^NEU-Agent-([0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,4}(-[0-9A-Za-z.]{1,16})?)-(mac-arm64\.dmg|mac-x64\.dmg|win-x64\.exe)$'
published_version() { python3 -c "import json,sys; print(json.load(open(sys.argv[1],encoding='utf-8')).get('version',''))" "$DLROOT/latest.json" 2>/dev/null || true; }
publish_desktop() { # $1 = thư mục đã giải nén
  local d="$1" f ver pub
  for f in "$d"/*; do
    [ -f "$f" ] || { echo "Gói bản cài chỉ được chứa tệp ở cấp trên cùng."; return 1; }
    f=$(basename "$f")
    case "$f" in SHA256SUMS.txt|latest.json|HUONG-DAN-CAI-DAT.md|BAO-MAT.md|MANIFEST) ;; *) [[ "$f" =~ $INSTALLER_RE ]] || { echo "Tên tệp không được phép: $f"; return 1; };; esac
  done
  [ -f "$d/latest.json" ] && [ -f "$d/SHA256SUMS.txt" ] || { echo "Thiếu latest.json hoặc SHA256SUMS.txt."; return 1; }
  # latest.json hợp lệ, mọi tệp nó khai đều có mặt, đúng kích thước + SHA-256; tên tệp đúng phiên bản
  ver=$(python3 - "$d" 2>&1 <<'PY'
import hashlib, json, os, re, sys
d = sys.argv[1]
j = json.load(open(os.path.join(d, "latest.json"), encoding="utf-8"))
v = j.get("version", "")
if not re.fullmatch(r"\d{1,4}\.\d{1,4}\.\d{1,4}(-[0-9A-Za-z.]{1,16})?", v): sys.exit("version không hợp lệ")
files = j.get("files") or {}
if not files: sys.exit("latest.json không khai tệp nào")
for name, meta in files.items():
    if not re.fullmatch(r"NEU-Agent-" + re.escape(v) + r"-(mac-arm64\.dmg|mac-x64\.dmg|win-x64\.exe)", name): sys.exit("tên tệp sai phiên bản/dạng: " + name)
    p = os.path.join(d, name)
    if not os.path.isfile(p): sys.exit("thiếu tệp: " + name)
    if os.path.getsize(p) != meta.get("size"): sys.exit("sai kích thước: " + name)
    h = hashlib.sha256()
    with open(p, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""): h.update(chunk)
    if h.hexdigest() != meta.get("sha256"): sys.exit("sai SHA-256: " + name)
print(v)
PY
  ) || { echo "latest.json không hợp lệ: ${ver:-}"; return 1; }
  (cd "$d" && sha256sum -c SHA256SUMS.txt >/dev/null 2>&1) || { echo "SHA256SUMS.txt không khớp tệp trong gói."; return 1; }
  pub=$(published_version)
  if [ -n "$pub" ] && [ "$(printf '%s\n%s\n' "$pub" "$ver" | sort -V | tail -1)" != "$ver" ]; then echo "Không hạ phiên bản: đang phát hành $pub, gói là $ver."; return 1; fi
  echo "Phát hành Desktop $ver (hiện có: ${pub:-chưa có})."
  install -d -m 0755 "$DLROOT"
  rm -f "$DLROOT"/.tmp.* "$DLROOT"/.latest.new "$DLROOT"/.SHA256SUMS.new   # dọn dấu vết của lần phát hành dở dang (nếu có)
  # 1) tệp cài trước (ghi tên tạm rồi đổi tên: không ai tải phải tệp dở dang), 2) hướng dẫn, 3) SHA256SUMS, 4) latest.json CUỐI CÙNG
  for f in "$d"/NEU-Agent-*; do cp -f "$f" "$DLROOT/.tmp.$(basename "$f")"; chmod 644 "$DLROOT/.tmp.$(basename "$f")"; mv -f "$DLROOT/.tmp.$(basename "$f")" "$DLROOT/$(basename "$f")"; done
  for f in HUONG-DAN-CAI-DAT.md BAO-MAT.md; do [ -f "$d/$f" ] && { cp -f "$d/$f" "$DLROOT/.tmp.$f"; chmod 644 "$DLROOT/.tmp.$f"; mv -f "$DLROOT/.tmp.$f" "$DLROOT/$f"; }; done
  # chỉ giữ bản mới và bản liền trước (để quay lui); SHA256SUMS liệt kê đúng các bản còn lại
  local keep
  keep=$(cd "$DLROOT" && ls -1 NEU-Agent-* 2>/dev/null | sed -E 's/^NEU-Agent-([0-9][^-]*(-[0-9A-Za-z.]+)?)-(mac|win)-.*/\1/' | sort -uV | tail -2)
  for f in "$DLROOT"/NEU-Agent-*; do
    [ -f "$f" ] || continue
    local v; v=$(basename "$f" | sed -E 's/^NEU-Agent-([0-9][^-]*(-[0-9A-Za-z.]+)?)-(mac|win)-.*/\1/')
    printf '%s\n' "$keep" | grep -qxF "$v" || rm -f "$f"
  done
  (cd "$DLROOT" && sha256sum NEU-Agent-* > .SHA256SUMS.new && chmod 644 .SHA256SUMS.new && mv -f .SHA256SUMS.new SHA256SUMS.txt)
  cp -f "$d/latest.json" "$DLROOT/.latest.new"; chmod 644 "$DLROOT/.latest.new"; mv -f "$DLROOT/.latest.new" "$DLROOT/latest.json"
  PUBLISHED_VERSION="$ver"
}

case "$CMD" in
  status)
    echo "đang chạy: $(current)"; echo "bản trước: $(readlink "$BASE/previous" 2>/dev/null || echo -)"
    [ -n "$(current)" ] && [ -f "$(current)/MANIFEST" ] && cat "$(current)/MANIFEST"
    echo "Desktop đang phát hành: $(published_version)"
    echo "--- lịch sử gần nhất:"; tail -n 10 "$HIST" 2>/dev/null || echo "(chưa có)"; exit 0;;
  rollback)
    prev=$(readlink "$BASE/previous" 2>/dev/null || true)
    [ -n "$prev" ] && [ -d "$prev" ] || { echo "Chưa có bản trước để quay lại."; exit 1; }
    cur=$(current)
    echo "Quay lại: $prev"
    if apply "$prev" "$cur"; then
      ln -sfn "$prev" "$BASE/current"; [ -n "$cur" ] && ln -sfn "$cur" "$BASE/previous"
      hist rollback ok "$(basename "$prev")"; echo "ROLLED_BACK $prev"; exit 0
    fi
    hist rollback FAIL "$(basename "$prev")"; echo "ROLLBACK THẤT BẠI"; exit 1;;
  deploy|publish-desktop) ;;
  *) echo "$USAGE"; exit 2;;
esac
[[ "$SHA" =~ ^[0-9a-f]{64}$ ]] || { echo "$USAGE"; exit 2; }

ID="$(date -u +%Y%m%d-%H%M%S)-${SHA:0:8}"

# ---------------------------------------------------------------- phát hành bản cài Desktop
if [ "$CMD" = publish-desktop ]; then
  D="$INC/desktop-$ID"
  receive "$MAX_DESKTOP_BYTES" "$D" || { hist publish-desktop REJECT "$ID"; rm -rf "$D"; exit 1; }
  MANIFEST_FILE="$D/MANIFEST"
  PUBLISHED_VERSION=""
  if publish_desktop "$D"; then
    hist publish-desktop ok "Desktop $PUBLISHED_VERSION"
    rm -rf "$D"; echo "PUBLISHED_DESKTOP $PUBLISHED_VERSION"; exit 0
  fi
  hist publish-desktop FAIL "$ID"; rm -rf "$D"; echo "!! Phát hành Desktop THẤT BẠI; trang tải giữ nguyên."; exit 1
fi

# ---------------------------------------------------------------- triển khai web + máy chủ
D="$REL/$ID"
receive "$MAX_BYTES" "$D" || { hist deploy REJECT "$ID"; rm -rf "$D"; exit 1; }
find "$D" -type f \( -name '*.sh' -o -name 'install*.sh' \) -exec chmod 0750 {} +
MANIFEST_FILE="$D/MANIFEST"
for f in install.sh web.tar.gz neu-agent.http.conf neu-agent.server.conf neu-agent.locations.conf neu-agent-auth.conf; do
  [ -f "$D/$f" ] || { hist deploy REJECT "$ID"; rm -rf "$D"; echo "Gói thiếu $f. Bị từ chối."; exit 1; }
done

OLD=$(current)
if apply "$D" "$OLD"; then
  [ -n "$OLD" ] && ln -sfn "$OLD" "$BASE/previous"
  ln -sfn "$D" "$BASE/current"
  prune
  hist deploy ok "$ID"
  echo "DEPLOYED $ID"
else
  echo "!! Triển khai $ID THẤT BẠI."
  if [ -n "$OLD" ] && [ -d "$OLD" ]; then
    echo "!! Đưa nginx + web về bản đang chạy trước đó ($OLD)…"
    (cd "$OLD" && bash ./install.sh >/dev/null 2>&1) && echo "Đã đưa về bản trước." || echo "KHÔNG đưa về được tự động: cần kiểm tra tay."
  fi
  hist deploy FAIL "$ID"
  rm -rf "$D"
  exit 1
fi
