[Unit]
Description=NEU Agent - sao luu du lieu khong tai tao duoc (ma hoa bang khoa cong khai)
After=neu-agent-diag.service neu-agent-quota.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/neu-agent-backup/backup.py run
# Chạy bằng root vì phải đọc tệp chỉ-root ở /etc/neu-agent và dữ liệu của neu-diag; chỉ giữ quyền đọc/ghi tệp (CHOWN: SQLite chạy bằng root
# tự trả tệp -shm nó tạo về cho chủ CSDL). Mặc định KHÔNG có mạng; có REMOTE thì install-backup.sh thêm drop-in remote.conf mở mạng tới đúng máy đích.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/neu-agent-data
# SQLite cần khoá/tạo -shm cạnh CSDL khi đọc (CSDL mở chỉ đọc, nội dung không bị sửa)
ReadWritePaths=-/var/lib/neu-agent/feedback -/var/lib/neu-agent/quota
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=@chown
UMask=0077
Nice=10
IOSchedulingClass=idle
MemoryMax=512M
TasksMax=32
TimeoutStartSec=3h
