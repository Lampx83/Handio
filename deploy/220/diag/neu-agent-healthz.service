[Unit]
Description=NEU Agent - kiem tra suc khoe (oauth2-proxy, cong mo hinh, dia, bo thu)
After=neu-agent-diag.service

[Service]
Type=oneshot
User=neu-diag
Group=neu-diag
Environment=NEU_HEALTH_GATEWAY=http://@@SITE_GATEWAY_HOSTPORT@@/
ExecStart=/usr/bin/python3 /usr/local/lib/neu-agent-diag/healthz.py
LogsDirectory=neu-agent
LogsDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/neu-agent
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# chỉ nói chuyện với loopback và cổng mô hình
IPAddressDeny=any
IPAddressAllow=localhost @@SITE_GATEWAY_IP@@
UMask=0027
MemoryMax=128M
TasksMax=16
TimeoutStartSec=60
