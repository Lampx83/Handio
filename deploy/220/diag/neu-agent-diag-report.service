[Unit]
Description=NEU Agent - bao cao chat luong hang ngay (tu chan doan + nhat ky nginx)
After=neu-agent-diag.service

[Service]
Type=oneshot
User=neu-diag
Group=neu-diag
# đọc nhật ký nginx (root:adm 0640); chỉ tệp neu-agent-access.json.log được dùng
SupplementaryGroups=adm
ExecStart=/usr/bin/python3 /usr/local/lib/neu-agent-diag/report.py
# Mặc định KHÔNG có mạng. Muốn bản nháp gợi ý bằng mô hình (--llm): đặt key ở /etc/neu-agent/llm-key rồi chạy lại install-diag.sh (tạo drop-in llm.conf).
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/neu-agent/reports
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0027
MemoryMax=512M
TasksMax=32
TimeoutStartSec=300
