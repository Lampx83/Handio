[Unit]
Description=NEU Agent - bo thu chan doan (collector, 127.0.0.1:4190)
After=network.target

[Service]
User=neu-diag
Group=neu-diag
# bí mật HMAC và danh sách quản trị: chỉ root đọc được ở /etc/neu-agent; systemd đưa vào thư mục tạm riêng của dịch vụ
LoadCredential=diag-secret:/etc/neu-agent/diag-secret
LoadCredential=admins:/etc/neu-agent/admins.txt
Environment=NEU_DIAG_DIR=/var/lib/neu-agent/diag
Environment=NEU_DIAG_REPORTS=/var/lib/neu-agent/reports
Environment=NEU_DIAG_HEALTH=/var/lib/neu-agent/health.json
# quản lý tài khoản (trang /agent/admin/accounts): chỉ GỌI dịch vụ phụ qua socket này; collector không tự ghi tệp mật khẩu
Environment=NEU_ACCOUNTS_SOCK=/run/neu-agent-accounts/accounts.sock
Environment=NEU_PUBLIC_HOST=ai.neu.edu.vn
ExecStart=/usr/bin/python3 /usr/local/lib/neu-agent-diag/collector.py
Restart=always
RestartSec=3
# cô lập như dịch vụ đăng nhập: không quyền ghi ngoài thư mục dữ liệu, không quyền đặc biệt, chỉ nói chuyện qua loopback
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/neu-agent/diag -/var/lib/neu-agent/quota
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
