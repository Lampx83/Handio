  "app": {
    "install": {
      "k": "hex",
      "min": 32,
      "max": 32
    },
    "version": {
      "k": "version"
    },
    "build": {
      "k": "hex",
      "min": 4,
      "max": 16
    },
    "platform": {
      "k": "enum",
      "v": [
        "web",
        "mac",
        "win",
        "linux",
        "other"
      ]
    },
    "profile": {
      "k": "enum",
      "v": [
        "work",
        "code",
        "design"
      ]
    },
    "model": {
      "k": "model"
    }
  },
  "events": {
    "turn": {
      "end": {
        "k": "enum",
        "v": [
          "ok",
          "interrupted",
          "error",
          "step_limit",
          "loop"
        ],
        "req": true
      },
      "dur_s": {
        "k": "int",
        "min": 0,
        "max": 86400
      },
      "ttft_ms": {
        "k": "int",
        "min": 0,
        "max": 3600000
      },
      "steps": {
        "k": "int",
        "min": 0,
        "max": 1000
      },
      "tools": {
        "k": "int",
        "min": 0,
        "max": 5000
      },
      "tool_fail": {
        "k": "int",
        "min": 0,
        "max": 5000
      },
      "prompt_tok": {
        "k": "int",
        "min": 0,
        "max": 1000000000
      },
      "completion_tok": {
        "k": "int",
        "min": 0,
        "max": 1000000000
      },
      "ctx_pct": {
        "k": "int",
        "min": 0,
        "max": 1000
      },
      "compactions": {
        "k": "int",
        "min": 0,
        "max": 100
      },
      "perm_allow": {
        "k": "int",
        "min": 0,
        "max": 5000
      },
      "perm_deny": {
        "k": "int",
        "min": 0,
        "max": 5000
      },
      "calls": {
        "k": "int",
        "min": 0,
        "max": 5000
      },
      "peak_prompt_tok": {
        "k": "int",
        "min": 0,
        "max": 1000000000
      },
      "cached_tok": {
        "k": "int",
        "min": 0,
        "max": 1000000000
      },
      "tool_out_tok": {
        "k": "int",
        "min": 0,
        "max": 1000000000
      },
      "pruned": {
        "k": "int",
        "min": 0,
        "max": 5000
      },
      "first_tool_s": {
        "k": "int",
        "min": 0,
        "max": 86400
      }
    },
    "tool": {
      "name": {
        "k": "tool",
        "req": true
      },
      "ok": {
        "k": "bool",
        "req": true
      },
      "dur": {
        "k": "enum",
        "v": [
          "lt1s",
          "lt5s",
          "lt30s",
          "lt2m",
          "ge2m"
        ],
        "req": true
      },
      "err": {
        "k": "enum",
        "v": [
          "not_found",
          "outside_project",
          "read_first",
          "stale",
          "binary",
          "bad_args",
          "no_match",
          "ambiguous",
          "wrong_type",
          "sandbox",
          "program",
          "timeout",
          "unsupported",
          "denied",
          "hook",
          "unknown_tool",
          "bad_json",
          "internal",
          "other"
        ]
      }
    },
    "llm_error": {
      "kind": {
        "k": "enum",
        "v": [
          "context",
          "auth",
          "rate",
          "server",
          "network",
          "insecure",
          "quota",
          "unexpected",
          "other"
        ],
        "req": true
      },
      "status": {
        "k": "int",
        "min": 0,
        "max": 599
      }
    },
    "llm_retry": {
      "kind": {
        "k": "enum",
        "v": [
          "network",
          "rate",
          "server"
        ],
        "req": true
      }
    },
    "signal": {
      "code": {
        "k": "enum",
        "v": [
          "loop",
          "step_limit",
          "repeat_tool_fail",
          "slow_first_token",
          "slow_turn",
          "ctx_high",
          "early_interrupt",
          "perm_denied",
          "empty_output",
          "invalid_tool_args",
          "unknown_tool",
          "truncated",
          "context_overflow",
          "args_truncated",
          "text_repeat"
        ],
        "req": true
      },
      "tool": {
        "k": "tool"
      },
      "n": {
        "k": "int",
        "min": 0,
        "max": 100000
      }
    },
    "ui": {
      "act": {
        "k": "enum",
        "v": [
          "tab_switch",
          "suggestion",
          "template",
          "attach",
          "learn_open",
          "settings_open",
          "new_chat",
          "open_chat",
          "mode_change",
          "model_change",
          "run_click",
          "changes_open",
          "login_prompt",
          "update_banner",
          "update_download",
          "download_open",
          "slash_command",
          "mention_file",
          "stop_click",
          "point_edit",
          "feedback_send",
          "share_create",
          "guide_open"
        ],
        "req": true
      }
    },
    "feedback": {
      "v": {
        "k": "enum",
        "v": [
          "up",
          "down"
        ],
        "req": true
      },
      "reason": {
        "k": "enum",
        "v": [
          "wrong",
          "slow",
          "incomplete",
          "confusing",
          "other"
        ]
      }
    },
    "report": {
      "note": {
        "k": "text",
        "max": 500
      }
    }
  }
}
