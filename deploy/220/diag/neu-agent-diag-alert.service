[Unit]
Description=NEU Agent - canh bao chu dong toi webhook (tuy chon; khong co webhook thi khong lam gi)
After=neu-agent-diag-stats.service

[Service]
Type=oneshot
User=neu-diag
Group=neu-diag
ExecStart=/usr/bin/python3 /usr/local/lib/neu-agent-diag/alerts.py
# Mặc định KHÔNG có mạng. Muốn nhận cảnh báo: đặt URL webhook https ở /etc/neu-agent/alert-webhook (0600) rồi chạy lại install-diag.sh
# (tạo drop-in net.conf: nạp URL qua LoadCredential và mở mạng cho đúng dịch vụ này). Tin chỉ có số liệu tổng hợp.
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadOnlyPaths=-/var/lib/neu-agent/reports -/var/lib/neu-agent/health.json
ReadWritePaths=-/var/lib/neu-agent/alerts
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0027
MemoryMax=128M
TasksMax=16
TimeoutStartSec=60
